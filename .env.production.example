# Job-Copilot 生产环境变量模板（平台无关）
# 服务器：复制为 .env.production（已被 git 忽略），供 docker-compose.prod.yml
# 与 scripts/deploy.sh 使用；其他容器平台：把同名变量填到平台的服务变量里。
# 真实密钥绝不提交。详见 docs/deployment.md。

# Session 签名密钥，至少 32 个字符。生成：python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=604800

# 账号：推荐部署后用 CLI 在数据库里创建（见 docs/deployment.md），此处留空。
# 如改用环境变量账号，APP_PASSWORD_HASH 含 `$`，必须用单引号包住整个值。
APP_USERNAME=
APP_PASSWORD_HASH=

# LLM 运行模式: fake | dry-run | live（live 需要 config/config.toml 中的 api_key/base_url）
LLM_MODE=dry-run

# 数据库：留空 = SQLite（存放在 compose 的 data 卷里）。
# 托管 PostgreSQL：postgresql://user:pass@host:5432/jobcopilot
# 使用 compose 自带 PostgreSQL：取消下面三行注释，并把 DATABASE_URL 设为
#   postgresql://jobcopilot:<POSTGRES_PASSWORD>@postgres:5432/jobcopilot
DATABASE_URL=
# COMPOSE_PROFILES=postgres
# POSTGRES_PASSWORD=

# 登录失败限流（按客户端 IP）
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# 对外端口。同机有反向代理时设 APP_BIND=127.0.0.1，并把 FORWARDED_ALLOW_IPS
# 设为 Docker 网桥网段（如 172.16.0.0/12），让 uvicorn 采信代理传来的真实 IP。
APP_BIND=0.0.0.0
APP_PORT=8080
FORWARDED_ALLOW_IPS=127.0.0.1
