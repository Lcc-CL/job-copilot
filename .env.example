# Job-Copilot 环境变量模板
# 通过 shell、进程管理器或部署平台注入；本地 .env 已在 .gitignore 中，
# 但当前 CLI 不会自动读取该文件。

# 运行模式: development | production
APP_ENV=development

# LLM 运行模式: fake | dry-run | live（未配置时默认 dry-run）
# live 还要求 config/config.toml 中同时存在 api_key 和 base_url。
LLM_MODE=dry-run

# 数据库 URL（默认 SQLite data/jobcopilot.db）
# PostgreSQL: postgresql+psycopg://user:pass@host:5432/jobcopilot
DATABASE_URL=

# 单用户认证（可由数据库账号覆盖；production 禁止默认账号）
APP_USERNAME=
APP_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=604800

# 仅本地开发兼容：admin/admin。必须显式开启，production 中始终无效。
APP_ALLOW_DEV_DEFAULTS=false

# 登录失败限流：同一客户端 IP 在窗口期内失败达到上限后返回 429（进程内存计数）
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
# 部署在反向代理之后时，填写代理的 IP/网段，让 uvicorn 采信
# X-Forwarded-For 识别真实客户端 IP；否则所有请求共用代理 IP 的失败计数。
# FORWARDED_ALLOW_IPS=

# 服务端口
PORT=8000

# 生成密码 hash: python -m job_copilot web hash-password
# 忘记密码时重置本地账号: python -m job_copilot web reset-password
